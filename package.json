{
  "name": "sphere-blink-ui-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright UI test suite for the Vanilla Sphere viewer (sphere-blink), generated from 38 manual test cases",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:desktop": "playwright test --project=desktop",
    "test:smartphone": "playwright test --project=smartphone",
    "test:smoke": "playwright test --grep @p0",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^26.6.6",
    "typescript": "^5.9.0"
  }
}
